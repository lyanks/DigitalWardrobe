# Copy this file to .env (same folder) and fill in your own values.
# .env is in .gitignore, so your secrets never reach GitHub.
# Flask reads .env automatically because python-dotenv is installed.

SECRET_KEY=change-me-to-a-long-random-string

# "Sign in with Google": create these in Google Cloud Console.
# Leave them empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your own email: the account with this email can open /admin.
ADMIN_EMAIL=

# AI help: suggests an item's details from its photo. Create a key at
# https://console.anthropic.com (buy a few dollars of credit and set a
# monthly limit there). Leave it empty to switch the AI off.
ANTHROPIC_API_KEY=
# Optional: AI_MODEL=claude-haiku-5-5 (default) and AI_DAILY_LIMIT=30

# Only on the PythonAnywhere server (see DEPLOY.md). Leave it out here.
# BEHIND_PROXY=1
