# Copy this file to .env (same folder) and fill in your own values.
# .env is in .gitignore, so your secrets never reach GitHub.
# Flask reads .env automatically because python-dotenv is installed.

SECRET_KEY=change-me-to-a-long-random-string

# "Sign in with Google": create these in Google Cloud Console.
# Leave them empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your own email: the account with this email can open /admin.
ADMIN_EMAIL=
